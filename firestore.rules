rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Since the application runs in an anonymous/unauthenticated environment
    // (no Firebase Auth on frontend tablets or client, and backend runs client-side SDK in unauthenticated mode),
    // we allow public read/write access for operational collections so that the system syncs in real time.
    // We restrict settings to read-only from client (writes happen via Cloud Functions),
    // and disable test collection access.

    // 1. menu (菜單)
    match /menu/{id} {
      allow read, write: if true;
    }

    // 2. orders (訂單) - allow read, create, update, delete (for bulk delete historical orders)
    match /orders/{id} {
      allow read, write: if true;
    }

    // 3. settings (設定) - read-only from client (writes happen via Cloud Functions)
    match /settings/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 4. categories (分類)
    match /categories/{id} {
      allow read, write: if true;
    }

    // 5. ingredients (原料/庫存)
    match /ingredients/{id} {
      allow read, write: if true;
    }

    // 6. tables (桌位)
    match /tables/{id} {
      allow read, write: if true;
    }

    // 7. reservations (預約)
    match /reservations/{id} {
      allow read, write: if true;
    }

    // 8. checkouts (收銀結帳紀錄)
    match /checkouts/{id} {
      allow read, write: if true;
    }

    // 9. test (測試連線用 - 生產環境停用)
    match /test/{id} {
      allow read, write: if false;
    }
  }
}
