rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. menu (菜單) - 前端公開唯讀，修改一律經由後端 API 驗證
    match /menu/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 2. categories (分類) - 前端唯讀
    match /categories/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 3. ingredients (原料/庫存) - 前端唯讀，庫存扣減由後端安全計算
    match /ingredients/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 4. tables (桌位狀態) - 前端公開唯讀
    match /tables/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 5. orders (訂單) - 前端唯讀即時監聽（需已驗證身分），建立與結帳一律由後端原子事務執行
    match /orders/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 6. reservations (預約) - 嚴格保護客戶個資與聯絡電話，僅限後端 Cloud Functions 驗證與存取
    match /reservations/{id} {
      allow read, write: if false;
    }

    // 7. checkouts (收銀結帳紀錄) - 嚴格禁止前端存取，僅限 Cloud Functions Admin SDK
    match /checkouts/{id} {
      allow read, write: if false;
    }

    // 8. settings (公開營運設定) - 前端唯讀，防止篡改全店營運與系統設定
    match /settings/{id} {
      allow read: if true;
      allow write: if false;
    }

    // 9. secrets & security (私密敏感設定、員工 PIN 雜湊、金鑰) - 嚴格封鎖前端讀寫
    match /secrets/{id} {
      allow read, write: if false;
    }

    // 10. _ratelimits (分散式速率限制內部記錄) - 嚴格封鎖前端讀寫
    match /_ratelimits/{id} {
      allow read, write: if false;
    }

    // 11. test (測試連線用 - 生產環境停用)
    match /test/{id} {
      allow read, write: if false;
    }

    // 12. 全域預設安全防護：未明確定義規則之所有路徑，一律嚴格拒絕存取
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

