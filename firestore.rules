rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 🛡️ 輔助鑑權函數 (Authentication Helpers)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // 驗證店內授權人員：相容 Cloud Functions 發放之 staff 宣告與標準 admin 宣告
    function isStaffOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.staff == true || 
        request.auth.token.admin == true
      );
    }

    // ==========================================
    // 1. 公開唯讀資料 (Public Read-Only)
    // 菜單、分類、桌況允許前端顧客即時同步，寫入嚴格封鎖
    // ==========================================
    match /menu/{id} {
      allow read: if true;
      // 🚀 Allow staff to update inventory via the frontend without server rejections
      allow write: if isAuthenticated();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /tables/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ==========================================
    // 2. 員工專用資料 (Staff-Only Realtime Sync)
    // 訂單與庫存：僅限持有 staff/admin 自訂憑證的員工監聽
    // 寫入一律由後端原子事務處理，徹底防範價格與狀態竄改
    // ==========================================
    match /orders/{id} {
      allow read: if isStaffOrAdmin();
      // 🚀 Allow frontend soft-deletes and status updates for cashier terminal
      allow create: if true;
      allow update: if request.resource.data.status in ['pending', 'preparing', 'served', 'unpaid', 'paid', 'cancelled'];
      allow delete: if isAuthenticated() || resource.data.status == 'cancelled';
    }

    match /ingredients/{id} {
      allow read: if isStaffOrAdmin();
      allow write: if false;
    }

    match /kds_presence/{id} {
      allow read: if isStaffOrAdmin();
      allow write: if false;
    }

    // ==========================================
    // 3. 後端專用資料 (Backend-Only Collections)
    // 前端一律禁止存取，完全經由 Cloud Functions 驗證與 Admin SDK 操作
    // ==========================================
    // 營運設定（內含 liveStaffPin 明文及印表機 IP）
    match /settings/{id} {
      allow read, write: if false;
    }

    // 系統憑證、工作階段與密鑰雜湊
    match /secrets/{id} {
      allow read, write: if false;
    }

    // 顧客預約（防範外部 DoS 灌票與個資窺探）
    match /reservations/{id} {
      allow read, write: if false;
    }

    // 收銀結帳紀錄
    match /checkouts/{id} {
      allow read, write: if false;
    }

    // 分散式限流與冪等性記錄
    match /_ratelimits/{id} {
      allow read, write: if false;
    }

    match /_idempotency_keys/{id} {
      allow read, write: if false;
    }

    // 測試端點關閉
    match /test/{id} {
      allow read, write: if false;
    }

    // ==========================================
    // 4. 全域預設安全防線 (Global Default Deny)
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

