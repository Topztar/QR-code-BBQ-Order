rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read/write access for real-time app operation
    match /{document=**} {
      allow read, write: if true;
    }

    // Since the application runs in an anonymous/unauthenticated environment
    // (no Firebase Auth on frontend tablets or client, and backend runs client-side SDK in unauthenticated mode),
    // we must allow public read/write access so that the system syncs in real time without permission errors.

    // 1. menu (菜單)
    match /menu/{id} {
      allow read, write: if true;
    }

    // 2. orders (訂單)
    match /orders/{id} {
      allow read, write: if true;
    }

    // 3. settings (設定)
    match /settings/{id} {
      allow read, write: if true;
    }

    // 4. categories (分類)
    match /categories/{id} {
      allow read, write: if true;
    }

    // 5. ingredients (原料/庫存)
    match /ingredients/{id} {
      allow read, write: if true;
    }

    // 6. tables (桌位)
    match /tables/{id} {
      allow read, write: if true;
    }

    // 7. reservations (預約)
    match /reservations/{id} {
      allow read, write: if true;
    }

    // 8. checkouts (收銀結帳紀錄)
    match /checkouts/{id} {
      allow read, write: if true;
    }

    // 9. test (測試連線用)
    match /test/{id} {
      allow read, write: if true;
    }
  }
}
