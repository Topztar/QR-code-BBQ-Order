#:kivy 2.3.1

<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 50
        spacing: 20
        Label:
            text: "BBQ 點餐系統 - 會員登入"
            font_size: '24sp'
        TextInput:
            id: email_input
            hint_text: "電子郵件 Email"
            multiline: False
        TextInput:
            id: password_input
            hint_text: "密碼 Password"
            password: True
            multiline: False
        Button:
            text: "登入 / 註冊"
            on_release: root.do_login(email_input.text, password_input.text)

<DashboardScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 10
        Label:
            text: "歡迎, " + root.username
            font_size: '20sp'
        Label:
            text: "系統時間: " + root.system_time
        Label:
            text: "總點數: " + str(root.total_points)
        Label:
            text: "最後簽到: " + root.last_checkin
        Button:
            text: "每日簽到"
            size_hint_y: 0.2
            on_release: root.do_checkin()
        Button:
            text: "開始點餐 (掃描 QR Code)"
            size_hint_y: 0.2
            on_release: root.start_order()

<QRScanScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 50
        spacing: 20
        Label:
            text: "模擬 QR Code 掃描"
        Button:
            text: "模擬掃描: 內用 1 桌"
            on_release: root.simulate_scan("table_1")
        Button:
            text: "模擬掃描: 取得外帶號碼"
            on_release: root.simulate_scan("takeout")
        Button:
            text: "返回"
            on_release: app.root.current = 'dashboard'

<MenuScreen>:
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: "菜單 (開發中)"
            size_hint_y: 0.1
        ScrollView:
            GridLayout:
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                # 這裡未來會動態產生餐點列表
                Button:
                    text: "測試餐點 A - $100\n[加入購物車]"
                    size_hint_y: None
                    height: 100
        Button:
            text: "查看購物車"
            size_hint_y: 0.2
            on_release: root.go_to_cart()

<CartScreen>:
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: "購物車"
        Button:
            text: "送出訂單"
            size_hint_y: 0.2
            on_release: root.submit_order()
        Button:
            text: "返回菜單"
            size_hint_y: 0.2
            on_release: app.root.current = 'menu'

<OrderStatusScreen>:
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: "您的訂單狀態"
            font_size: '24sp'
        Label:
            text: "狀態: 等待管理員確認中..."
        Button:
            text: "返回首頁"
            size_hint_y: 0.2
            on_release: root.back_to_dashboard()
