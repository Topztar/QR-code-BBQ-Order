# Real-time Admin Notifications (LINE & Gmail)
# LINE Messaging API Channel Access Token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Admin User ID (or Group/Room ID) to receive push messages
LINE_ADMIN_USER_ID=

# Gmail SMTP Sender/Recipient address (e.g. yourstore@gmail.com)
GMAIL_USER=

# Gmail 16-character App Password (generated under Google Account > Security > App Passwords)
GMAIL_APP_PASS=
